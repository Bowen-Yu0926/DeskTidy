#include <winver.h>

#ifdef _WIN32
LANGUAGE 0x09, 0x01

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,0,55,0
 PRODUCTVERSION 4,0,55,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DeskTidy"
            VALUE "FileDescription", "DeskTidy Native"
            VALUE "FileVersion", "4.0.55"
            VALUE "InternalName", "desktidy_native"
            VALUE "LegalCopyright", "DeskTidy"
            VALUE "OriginalFilename", "desktidy_native.exe"
            VALUE "ProductName", "DeskTidy Native"
            VALUE "ProductVersion", "4.0.55"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif
