#include <winver.h>

#ifdef _WIN32
LANGUAGE 0x09, 0x01

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,0,60,0
 PRODUCTVERSION 4,0,60,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DeskTidy"
            VALUE "FileDescription", "DeskNote - 系统文件提权保存"
            VALUE "FileVersion", "4.0.60"
            VALUE "InternalName", "deskNote"
            VALUE "LegalCopyright", "DeskTidy"
            VALUE "OriginalFilename", "deskNote.exe"
            VALUE "ProductName", "DeskNote"
            VALUE "ProductVersion", "4.0.60"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
#endif
