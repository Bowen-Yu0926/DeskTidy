# Copy to .env.cloudflare and fill in. Never commit .env.cloudflare.
# Deploy DeskTidy intro pages (docs/index.html + desktidy.html + desknote.html)
# to a Cloudflare Pages project — do NOT overwrite chromhome.kdns.fr root (StarNav).

# Create token: Cloudflare Dashboard → My Profile → API Tokens
# Template "Edit Cloudflare Pages" is enough (Account.Cloudflare Pages:Edit).
CLOUDFLARE_API_TOKEN=

# Optional if the token is scoped to one account / wrangler already knows it.
CLOUDFLARE_ACCOUNT_ID=

# Pages project name (create empty project once in dashboard, or let wrangler create).
CF_PAGES_PROJECT=desktidy-site

# Printed after deploy / used in docs (custom domain or *.pages.dev).
CF_SITE_URL=https://desktidy-site.pages.dev/
