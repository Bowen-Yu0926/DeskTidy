native/third_party/webview2.nupkg
native/third_party/Microsoft.Web.WebView2/
native/third_party/webview2/
*.spec.bak

# Bundled FFmpeg is large and downloaded by scripts\prepare_ffmpeg_recording.py
assets/ffmpeg/
assets/ffmpeg.staging/

# Runtime / user data (do not publish)
logs/
录屏/
笔记/
纪要/
邮件/
*.log

